# Copy to .env and fill in. Never commit .env (it is git-ignored).
# The CLI auto-loads .env from the working directory (no override of
# already-exported variables).

# AI hypothesis planning (ai/planner.py). Without this, --ai stages are
# skipped gracefully.
GEMINI_API_KEY=

# Confirmed subdomain takeover via tko-subs -takeover (needs repo scope:
# creates repos/branches to claim dangling GitHub Pages CNAMEs).
GITHUB_TOKEN=

# Confirmed Heroku takeover (dangling *.herokudns.com CNAMEs are added to
# this app). Only needed together with GITHUB_TOKEN usage.
HEROKU_USERNAME=
HEROKU_API_KEY=
HEROKU_APP_NAME=
