# Copy to .env and fill in. Never commit .env (it is git-ignored).
# The CLI auto-loads .env from the working directory (no override of
# already-exported variables).

# AI hypothesis planning (ai/planner.py). Gemini is tried first, with
# Groq as the free-tier hosted fallback. Ollama needs no key.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override the Ollama server (default http://localhost:11434).
#OLLAMA_HOST=http://localhost:11434

# Login passwords for automated form login (agent Phase 2). One variable
# per login identity, referenced by password_env in config.yaml.
#USER_A_PASSWORD=
#USER_B_PASSWORD=

# Confirmed subdomain takeover via tko-subs -takeover (needs repo scope:
# creates repos/branches to claim dangling GitHub Pages CNAMEs).
GITHUB_TOKEN=

# Confirmed Heroku takeover (dangling *.herokudns.com CNAMEs are added to
# this app). Only needed together with GITHUB_TOKEN usage.
HEROKU_USERNAME=
HEROKU_API_KEY=
HEROKU_APP_NAME=
